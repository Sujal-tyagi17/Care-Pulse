# Healthcare Appointment & Follow-Up Manager - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL / Cloud PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key
JWT_SECRET="your-secure-jwt-secret"

# LLM Service API Keys (Optional - Automatic Intelligent Clinical Fallback Engine is active if unset)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email Notifications (Optional - Automatically falls back to Ethereal / Stream transporter for testing)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CarePulse Health <no-reply@carepulse-health.org>"

# Google Calendar Integration (Optional - Direct web link & .ICS file generation works out-of-the-box)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Blockchain (Optional - prescriptions are anchored on-chain only when ALL of these are set)
# Deploy the contract first:  cd blockchain && npm run deploy:amoy   (prints the values below)
BLOCKCHAIN_RPC_URL="https://rpc-amoy.polygon.technology"
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_REGISTRY_ADDRESS=""
# Hospital wallet: deploys the contract, registers doctors and pays gas (fund it from a testnet faucet)
BLOCKCHAIN_RELAYER_PRIVATE_KEY=""
# Master secret from which each doctor's signing key is derived (long random string, never share)
BLOCKCHAIN_DOCTOR_KEY_SECRET=""
BLOCKCHAIN_EXPLORER_URL="https://amoy.polygonscan.com"
BLOCKCHAIN_CONFIRMATIONS=1

# Frontend URL
CLIENT_URL="http://localhost:5173"
